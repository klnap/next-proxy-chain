{
  "name": "@klnap/next-proxy-chain",
  "version": "1.2.0",
  "description": "Composable proxy and middleware for Next.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klnap/next-proxy-chain.git"
  },
  "bugs": {
    "url": "https://github.com/klnap/next-proxy-chain/issues"
  },
  "homepage": "https://github.com/klnap/next-proxy-chain#readme",
  "license": "MIT",
  "author": "klnap",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "sideEffects": false,
  "keywords": [
    "nextjs",
    "nextjs15",
    "nextjs16",
    "next-proxy",
    "proxy",
    "next-middleware",
    "middleware",
    "middleware-chain",
    "request-pipeline",
    "chain",
    "edge"
  ],
  "files": [
    "dist/index.cjs",
    "dist/index.d.cts",
    "dist/index.d.ts",
    "dist/index.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "check": "bun run format && bun run lint && bun run typecheck && bun test && bun run build && bun run verify:package",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:version-check": "bun run changeset:version && bun run check",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint": "biome lint .",
    "verify:package": "publint --strict && attw --profile node16 --pack ."
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.5",
    "@types/node": "^20",
    "next": "16.3.2",
    "npm": "12.2.3",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
